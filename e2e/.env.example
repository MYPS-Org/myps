# Copy to .env and fill in for your local environment.
# Read by tests/helpers/auth.ts login() as the default credentials.
# Loaded automatically via `import 'dotenv/config'` in playwright.config.ts.

E2E_USERNAME=testuser
E2E_PASSWORD=***REMOVED***

# batch-restrict-allow-publish-skips-published.spec.ts flips tProjects.IsPublished
# directly via sqlcmd. Point these at the SAME database the API under test uses.
# Omit E2E_SQL_USER/E2E_SQL_PASSWORD to use Windows auth (sqlcmd -E).
# E2E_SQL_SERVER=localhost
# E2E_SQL_DB=myps_db_dev
# E2E_SQL_USER=sa
# E2E_SQL_PASSWORD=
