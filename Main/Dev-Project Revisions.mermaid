erDiagram

    %% ─── REVISION OPTION TABLES ─────────────────────────────

    tOptionRevisionHeader {
        int         Id                  PK
        nvarchar    RevisionName
        int         RevisionGroupId     UK
    }

    tOptionRevisionCategory {
        int         Id                  PK
        nvarchar    CategoryName
        int         CategoryId          UK
        int         RevisionGroupId     FK
    }

    tOptionRevisionReasons {
        int         Id                  PK
        nvarchar    Reason
        int         RevisionGroupId     FK
        int         ReasonId            UK
        nvarchar    CategoryId          FK
        bit         IsDeleted
    }

    tOptionRevisionStatus {
        int         Id                  PK
        int         Enum                UK
        nvarchar    Name
        nvarchar    Description
    }

    %% ─── REVISION DETAILS ────────────────────────────────────

    tRevisionDetails {
        int         Id                  PK
        nvarchar    ProgramRevisionId
        nvarchar    TransactionId       UK
        int         RevisionGroupId     FK
        int         CategoryId          FK
        int         ReasonId            FK
        datetime    IODocApprovalDate
        int         RegionStatus        FK
        nvarchar    RegionDescription
        nvarchar    RegionApprover
        datetime    RegionApprovedDate
        datetime    RegionLastUpdatedDate
        int         COStatus            FK
        datetime    CODocApprovalDate
        nvarchar    CODescription
        nvarchar    COApprover
        datetime    COApprovedDate
        datetime    COLastUpdatedDate
        nvarchar    CreatedBy
        datetime    CreatedDate
    }

    tRevisionDocuments {
        int         Id                  PK
        nvarchar    TransactionId       FK
        nvarchar    DocumentName
        nvarchar    DocumentPath
        bit         IsApprovedDocument
    }

    tRevisionForCorrectionDetails {
        int         Id                  PK
        nvarchar    TransactionId       FK
        nvarchar    CorrectionReason
        datetime    ForCorrectionDate
        bit         IsCentralOffice
    }

    %% ─── REVISION PROJECTS ──────────────────────────────────

    tRevisionProjects {
        int         Id                  PK
        int         RevisionId          FK
        bit         IsActive
        nvarchar    TransactionId       FK
        nvarchar    ReferenceId
        nvarchar    ProjectId           UK
        nvarchar    AlternateId
        nvarchar    ExternalId
        nvarchar    MYId
        nvarchar    UACS
        datetime    MYCAApprovalDate
        nvarchar    Description
        int         Category            FK
        int         Thrust              FK
        int         Origin              FK
        nvarchar    City                FK
        nvarchar    Province            FK
        nvarchar    LegislativeDistrict FK
        nvarchar    OperatingUnit       FK
        nvarchar    ImplementingOffice  FK
        nvarchar    DEO                 FK
        nvarchar    Region              FK
        int         Agency              FK
        int         ImplementationMode  FK
        int         EmergencyMode       FK
        nvarchar    IslandCode          FK
        int         Feasibility         FK
        datetime    FeasibilityDate
        int         DetailedDesign      FK
        datetime    DetailedDesignDate
        int         RowAvailable        FK
        int         RegionWide          FK
        int         Tier
        float       Rank
        bit         IsDeleted
    }

    %% ─── REVISION COMPONENT COST ────────────────────────────

    tRevisionProjectComponentCost {
        int         Id                  PK
        nvarchar    TransactionId       FK
        nvarchar    ProjectId           FK
        nvarchar    CostId              UK
        nvarchar    ComponentType
        nvarchar    ComponentId         FK
        nvarchar    Description
        float       Total
        bit         IsDeleted
    }

    tRevisionProjectComponentCostPerYear {
        int         Id                  PK
        nvarchar    TransactionId       FK
        nvarchar    ComponentCostId     FK
        float       Amount
        int         Year
        datetime    StartDate
        datetime    EndDate
        bit         IsDeleted
    }

    %% ─── REVISION MAJOR WORK ────────────────────────────────

    tRevisionProjectMajorWorkItem {
        int         Id                  PK
        nvarchar    TransactionId       FK
        nvarchar    ProjectId           FK
        nvarchar    ReferenceId         UK
        nvarchar    ComponentId         FK
        int         YearOfWork
        int         WorkTypeId          FK
        nvarchar    InfraType           FK
        bit         IsDeleted
    }

    tRevisionProjectMajorWorkLocations {
        int         Id                  PK
        nvarchar    TransactionId       FK
        nvarchar    ParentId            FK
        nvarchar    InfraId
        nvarchar    DetailedScope
        int         TargetUnitId
        nvarchar    TargetUnit
        float       StartX
        float       StartY
        float       EndX
        float       EndY
        float       PhysicalTarget
        nvarchar    StartStationLimit
        nvarchar    EndStationLimit
        float       EndChainage
        float       StartChainage
        float       Length
        bit         IsDeleted
    }

    %% ─── REVISION FUNDING ───────────────────────────────────

    tRevisionProjectFundingProfile {
        int         Id                  PK
        nvarchar    TransactionId       FK
        nvarchar    ProjectId           FK
        nvarchar    Source              FK
        nvarchar    Agreement           FK
        float       Amount
        float       Percentage
        bit         IsDeleted
    }

    %% ─── REVISION TRANSACTION LOG ───────────────────────────

    tRevisionTransactionLog {
        int         Id                  PK
        nvarchar    TransactionId       FK
        nvarchar    ReferenceId
        nvarchar    TypeOfTransaction
        nvarchar    AffectedTable
        nvarchar    AffectedColumn
        nvarchar    OldValue
        nvarchar    NewValue
        nvarchar    CreatedBy
        datetime    CreatedDate
    }

    %% ─── OPTION DROPDOWNS (from Programs and Projects ERD) ─

    tOptionProjectCategory {
        int         Id                  PK
        int         CategoryId          UK
        nvarchar    CategoryName
        int         Minimum
        int         Maximum
        int         ValidUntil
    }

    tProjectThrustLists {
        int         Id                  PK
        int         PAPKey              UK
        nvarchar    ProgramName
        nvarchar    SubProgramName
        nvarchar    ActivityName
        int         SequenceNumber
        int         ValidFromDate
        int         ValidToDate
        nvarchar    InfrastructureType
        nvarchar    ThrustDescription
    }

    tOptionProjectOrigin {
        int         Id                  PK
        int         NameId              UK
        nvarchar    Name
        nvarchar    Description
    }

    tOptionAdminAreaCityMunicipality {
        int         Id                  PK
        nvarchar    GdbId               UK
        nvarchar    Name
        nvarchar    Code
        nvarchar    ProvinceGdbId
        nvarchar    ProvinceName
    }

    tOptionAdminAreaProvince {
        int         Id                  PK
        nvarchar    GdbId               UK
        nvarchar    Name
        nvarchar    Code
        nvarchar    RegionParticipantId
        nvarchar    RegionName
    }

    tOptionAdminAreaCongressionalDistrict {
        int         Id                  PK
        nvarchar    GdbId               UK
        nvarchar    Name
        nvarchar    Code
        nvarchar    ProvinceGdbId
        nvarchar    ProvinceName
    }

    tOptionAdminAreaDistrictEngineeringOffice {
        int         Id                  PK
        nvarchar    GdbId
        nvarchar    Name
        nvarchar    ParticipantId       UK
        nvarchar    ProvinceGdbId
        nvarchar    ProvinceName
        nvarchar    RegionParticipantId
        nvarchar    RegionName
    }

    tOptionAdminAreaRegion {
        int         Id                  PK
        nvarchar    GdbId               UK
        nvarchar    Name
        nvarchar    ParticipantId       UK
        varchar     IslandCode
    }

    tOptionAdminAreaCentralOffices {
        int         Id                  PK
        nvarchar    Name
        nvarchar    ParticipantId       UK
    }

    tOptionAdminAreaUPMO {
        int         Id                  PK
        nvarchar    Name
        nvarchar    ParticipantId       UK
    }

    tOptionAdminBureau {
        int         Id                  PK
        nvarchar    Name
        nvarchar    ParticipantId       UK
    }

    %% ─── VIEWS ───────────────────────────────────────────────

    %% vAdminOperatingUnit (view)
    %% Sources: tOptionAdminAreaDistrictEngineeringOffice, tOptionAdminAreaRegion, tOptionAdminAreaCentralOffices
    vAdminOperatingUnit {
        nvarchar    Name
        nvarchar    ParticipantId       UK
        nvarchar    OrgType
        nvarchar    RegionParticipantId
        nvarchar    RegionName
    }

    %% vAdminImplementingOffice (view)
    %% Sources: tOptionAdminAreaDistrictEngineeringOffice, tOptionAdminAreaRegion, tOptionAdminAreaCentralOffices, tOptionAdminAreaUPMO, tOptionAdminBureau
    vAdminImplementingOffice {
        nvarchar    Name
        nvarchar    ParticipantId       UK
        nvarchar    OrgType
        nvarchar    RegionParticipantId
        nvarchar    RegionName
    }

    tOptionProjectAgency {
        int         Id                  PK
        int         NameId              UK
        nvarchar    Name
        nvarchar    Description
    }

    tOptionProjectImplementationMode {
        int         Id                  PK
        int         NameId              UK
        nvarchar    Name
        nvarchar    Description
    }

    tOptionProjectEmergencyMode {
        int         Id                  PK
        int         NameId              UK
        nvarchar    Name
        nvarchar    Description
    }

    tOptionProjectFeasibilityStudy {
        int         Id                  PK
        int         NameId              UK
        nvarchar    Name
        nvarchar    Description
    }

    tOptionProjectDetailedDesign {
        int         Id                  PK
        int         NameId              UK
        nvarchar    Name
        nvarchar    Description
    }

    tOptionProjectRowAvailable {
        int         Id                  PK
        int         NameId              UK
        nvarchar    Name
        nvarchar    Description
    }

    tOptionRegionWide {
        int         Id                  PK
        int         NameId              UK
        nvarchar    Name
        nvarchar    Description
    }

    tOptionFundingSource {
        int         Id                  PK
        nvarchar    Organization        UK
        nvarchar    Name
        nvarchar    Nature
        nvarchar    CreatedBy
        datetime    CreatedDate
        nvarchar    UpdatedBy
        datetime    UpdatedDate
    }

    tOptionFundingAgreement {
        int         Id                  PK
        nvarchar    SourceOrg
        nvarchar    Code                UK
        nvarchar    Name
        nvarchar    FinancingSourceSegmentCode
        nvarchar    CreatedBy
        datetime    CreatedDate
        nvarchar    UpdatedBy
        datetime    UpdatedDate
    }

    tOptionProjectComponent {
        int         Id                  PK
        nvarchar    ComponentId         UK
        nvarchar    ComponentName
        bit         ExportToPCMA
        bit         IsDeleted
    }

    tOptionScopeOfWork {
        int         Id                  PK
        int         Enum                UK
        nvarchar    InfraType
        nvarchar    WorkCategory
        nvarchar    Description
        nvarchar    Measure
        int         MaxAmount
        int         MinAmount
    }

    tOptionInfraType {
        int         Id                  PK
        int         InfraId
        nvarchar    InfraCode           UK
        nvarchar    InfraName
    }

    %% ─── RELATIONSHIPS ──────────────────────────────────────

    %% Revision option table hierarchy
    tOptionRevisionHeader       ||--o{ tOptionRevisionCategory      : "RevisionGroupId"
    tOptionRevisionHeader       ||--o{ tOptionRevisionReasons       : "RevisionGroupId"
    tOptionRevisionCategory     ||--o{ tOptionRevisionReasons       : "CategoryId"

    %% Revision Details relationships
    tOptionRevisionHeader       ||--o{ tRevisionDetails             : "RevisionGroupId"
    tOptionRevisionCategory     ||--o{ tRevisionDetails             : "CategoryId"
    tOptionRevisionReasons      ||--o{ tRevisionDetails             : "ReasonId"
    tOptionRevisionStatus       ||--o{ tRevisionDetails             : "Enum > RegionStatus"
    tOptionRevisionStatus       ||--o{ tRevisionDetails             : "Enum > COStatus"

    %% Revision Details children
    tRevisionDetails            ||--o{ tRevisionDocuments           : "TransactionId"
    tRevisionDetails            ||--o{ tRevisionForCorrectionDetails : "TransactionId"
    tRevisionDetails            ||--o{ tRevisionProjects            : "Id > RevisionId"
    tRevisionDetails            ||--o{ tRevisionTransactionLog      : "TransactionId"

    %% Revision Projects option dropdown references (defined in Programs and Projects ERD)
    tOptionProjectCategory                       ||--o{ tRevisionProjects : "CategoryId > Category"
    tProjectThrustLists                          ||--o{ tRevisionProjects : "PAPKey > Thrust"
    tOptionProjectOrigin                         ||--o{ tRevisionProjects : "NameId > Origin"
    tOptionAdminAreaCityMunicipality             ||--o{ tRevisionProjects : "GdbId > City"
    tOptionAdminAreaProvince                     ||--o{ tRevisionProjects : "GdbId > Province"
    tOptionAdminAreaCongressionalDistrict        ||--o{ tRevisionProjects : "GdbId > LegislativeDistrict"
    tOptionAdminAreaDistrictEngineeringOffice    ||--o{ tRevisionProjects : "ParticipantId > DEO"
    tOptionAdminAreaRegion                       ||--o{ tRevisionProjects : "ParticipantId > Region"
    tOptionAdminAreaRegion                       ||--o{ tRevisionProjects : "IslandCode > IslandCode"
    tOptionProjectAgency                         ||--o{ tRevisionProjects : "NameId > Agency"
    tOptionProjectImplementationMode             ||--o{ tRevisionProjects : "NameId > ImplementationMode"
    tOptionProjectEmergencyMode                  ||--o{ tRevisionProjects : "NameId > EmergencyMode"
    tOptionProjectFeasibilityStudy               ||--o{ tRevisionProjects : "NameId > Feasibility"
    tOptionProjectDetailedDesign                 ||--o{ tRevisionProjects : "NameId > DetailedDesign"
    tOptionProjectRowAvailable                   ||--o{ tRevisionProjects : "NameId > RowAvailable"
    tOptionRegionWide                            ||--o{ tRevisionProjects : "NameId > RegionWide"

    %% Revision Component Cost relationships (option dropdowns from Programs and Projects ERD)
    tRevisionProjects               ||--o{ tRevisionProjectComponentCost        : "ProjectId"
    tOptionProjectComponent         ||--o{ tRevisionProjectComponentCost        : "ComponentId"
    tRevisionProjectComponentCost   ||--o{ tRevisionProjectComponentCostPerYear : "CostId > ComponentCostId"

    %% Revision Major Work relationships (option dropdowns from Programs and Projects ERD)
    tRevisionProjects               ||--o{ tRevisionProjectMajorWorkItem        : "ProjectId"
    tOptionProjectComponent         ||--o{ tRevisionProjectMajorWorkItem        : "ComponentId"
    tOptionScopeOfWork              ||--o{ tRevisionProjectMajorWorkItem        : "Enum > WorkTypeId"
    tOptionInfraType                ||--o{ tRevisionProjectMajorWorkItem        : "InfraCode > InfraType"
    tRevisionProjectMajorWorkItem   ||--o{ tRevisionProjectMajorWorkLocations   : "ReferenceId > ParentId"

    %% Revision Funding relationships (option dropdowns from Programs and Projects ERD)
    tRevisionProjects               ||--o{ tRevisionProjectFundingProfile       : "ProjectId"
    tOptionFundingSource            ||--o{ tRevisionProjectFundingProfile       : "Organization > Source"
    tOptionFundingAgreement         ||--o{ tRevisionProjectFundingProfile       : "Code > Agreement"

    %% View source relationships
    tOptionAdminAreaDistrictEngineeringOffice ||--o{ vAdminOperatingUnit         : "ParticipantId (DEO)"
    tOptionAdminAreaRegion                   ||--o{ vAdminOperatingUnit         : "ParticipantId (Region)"
    tOptionAdminAreaCentralOffices           ||--o{ vAdminOperatingUnit         : "ParticipantId (CO)"
    tOptionAdminAreaDistrictEngineeringOffice ||--o{ vAdminImplementingOffice    : "ParticipantId (DEO)"
    tOptionAdminAreaRegion                   ||--o{ vAdminImplementingOffice    : "ParticipantId (Region)"
    tOptionAdminAreaCentralOffices           ||--o{ vAdminImplementingOffice    : "ParticipantId (CO)"
    tOptionAdminAreaUPMO                     ||--o{ vAdminImplementingOffice    : "ParticipantId (UPMO)"
    tOptionAdminBureau                       ||--o{ vAdminImplementingOffice    : "ParticipantId (Bureau)"
    vAdminOperatingUnit                      ||--o{ tRevisionProjects           : "ParticipantId > OperatingUnit"
    vAdminImplementingOffice                 ||--o{ tRevisionProjects           : "ParticipantId > ImplementingOffice"
