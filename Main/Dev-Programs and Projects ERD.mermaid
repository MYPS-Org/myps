    }

    tProjectMajorWorkItem {
        int         Id                  PK
        nvarchar    ProjectId           FK
        nvarchar    ReferenceId         UK
        nvarchar    ComponentId         FK
        int         YearOfWork
        int         WorkTypeId          FK
        nvarchar    InfraType           FK
        nvarchar    StageName           FK
        nvarchar    CreatedBy
        datetime    CreatedDate
        nvarchar    UpdatedBy
        datetime    UpdatedDate
        bit         IsDeleted
        nvarchar    ProgramUniqueId
    }

    tProjectMajorWorkLocations {
        int         Id                  PK
        nvarchar    ParentId            FK
        nvarchar    StageName
        nvarchar    InfraId
        nvarchar    DetailedScope
        int         TargetUnitId
        nvarchar    TargetUnit
        float       StartX
        float       StartY
        float       EndX
        float       EndY
        float       PhysicalTarget
        nvarchar    StartStationLimit
        nvarchar    EndStationLimit
        float       EndChainage
        float       StartChainage
        float       Length
        nvarchar    CreatedBy
        datetime    CreatedDate
        nvarchar    UpdatedBy
        datetime    UpdatedDate
        bit         IsDeleted
        nvarchar    ProgramUniqueId
    }

