    %% ─── RELATIONSHIPS ───────────────────────────────────────

    %% Program relationships
    tPrograms               ||--o{ tProgramStages               : "ProgramId"
    tPrograms               ||--o{ tProgramRevisions            : "ProgramId"
    tProgramRevisions       ||--o{ tProgramStages               : "RevisionId > Id"
    tOptionProgramStage     ||--o{ tProgramStages               : "NameId > StageId"
    tOptionProgramStage     ||--o{ tProgramStages               : "Name > StageName"

    %% Project relationships
    tPrograms               ||--o{ tProjects                    : "ProgramId"
    tProjects               ||--o{ tProjectStages               : "ReferenceId"
    tProjectStages          }o--|| tProjectRevisions            : "RevisionId > Id"
    tProjects               ||--o{ tProjectRevisions            : "ReferenceId > ProjectId"
    tOptionProgramStage     ||--o{ tProjectStages               : "NameId > StageId"
    tOptionProgramStage     ||--o{ tProjectStages               : "Name > StageName"

    %% Component Cost relationships
    tProjects               ||--o{ tProjectComponentCost        : "ReferenceId > ProjectId"
    tOptionProjectComponentType ||--o{ tProjectComponentCost        : "ComponentId"
    tProjectComponentCost   ||--o{ tProjectComponentCostPerYear : "CostId > ComponentCostId"
    tOptionProgramStage     ||--o{ tProjectComponentCost        : "Name > StageName"
    tOptionProgramStage     ||--o{ tProjectComponentCostPerYear : "Name > StageName"

    %% Major Work relationships
    tProjects               ||--o{ tProjectMajorWorkItem        : "ReferenceId > ProjectId"
    tOptionProjectComponentType ||--o{ tProjectMajorWorkItem        : "ComponentId"
    tOptionScopeOfWork      ||--o{ tProjectMajorWorkItem        : "Enum > WorkTypeId"
    tOptionInfraType        ||--o{ tProjectMajorWorkItem        : "InfraCode > InfraType"
    tProjectMajorWorkItem   ||--o{ tProjectMajorWorkLocations   : "ReferenceId > ParentId"
    tOptionProgramStage     ||--o{ tProjectMajorWorkItem        : "Name > StageName"

    %% Funding relationships
    tProjects               ||--o{ tProjectFundingProfile       : "ReferenceId > ProjectId"
    tOptionFundingSource    ||--o{ tProjectFundingProfile       : "Organization > Source"
    tOptionFundingAgreement ||--o{ tProjectFundingProfile       : "Code > Agreement"
    tOptionProgramStage     ||--o{ tProjectFundingProfile       : "Name > StageName"

    %% ProjectRevisions lookup relationships
    tOptionProjectCategory              ||--o{ tProjectRevisions : "CategoryId > Category"
    tOptionProjectThrustList                 ||--o{ tProjectRevisions : "PAPKey > Thrust"
    tOptionProjectOrigin                ||--o{ tProjectRevisions : "NameId > Origin"
    tOptionAdminAreaCityMunicipality    ||--o{ tProjectRevisions : "GdbId > City"
    tOptionAdminAreaProvince            ||--o{ tProjectRevisions : "GdbId > Province"
    tOptionAdminAreaCongressionalDistrict ||--o{ tProjectRevisions : "GdbId > LegislativeDistrict"
    tOptionAdminAreaDistrictEngineeringOffice ||--o{ tProjectRevisions : "ParticipantId > DEO"
    tOptionAdminAreaRegion              ||--o{ tProjectRevisions : "ParticipantId > Region"
    tOptionAdminAreaRegion              ||--o{ tProjectRevisions : "IslandCode > IslandCode"
    tOptionProjectAgency                ||--o{ tProjectRevisions : "NameId > Agency"
    tOptionProjectImplementationMode    ||--o{ tProjectRevisions : "NameId > ImplementationMode"
    tOptionProjectEmergencyMode         ||--o{ tProjectRevisions : "NameId > EmergencyMode"
    tOptionProjectFeasibilityStudy      ||--o{ tProjectRevisions : "NameId > Feasibility"
    tOptionProjectDetailedDesign        ||--o{ tProjectRevisions : "NameId > DetailedDesign"
    tOptionProjectRowAvailable          ||--o{ tProjectRevisions : "NameId > RowAvailable"
    tOptionRegionWide                   ||--o{ tProjectRevisions : "NameId > RegionWide"

    %% Admin area hierarchy
    tOptionAdminAreaRegion              ||--o{ tOptionAdminAreaProvince                   : "ParticipantId > RegionParticipantId"
    tOptionAdminAreaProvince            ||--o{ tOptionAdminAreaCityMunicipality           : "GdbId > ProvinceGdbId"
    tOptionAdminAreaProvince            ||--o{ tOptionAdminAreaCongressionalDistrict      : "GdbId > ProvinceGdbId"
    tOptionAdminAreaRegion              ||--o{ tOptionAdminAreaDistrictEngineeringOffice  : "ParticipantId > RegionParticipantId"

    %% View source relationships
    tOptionAdminAreaDistrictEngineeringOffice ||--o{ vAdminOperatingUnit         : "ParticipantId (DEO)"
    tOptionAdminAreaRegion                   ||--o{ vAdminOperatingUnit         : "ParticipantId (Region)"
    tOptionAdminAreaCentralOffices           ||--o{ vAdminOperatingUnit         : "ParticipantId (CO)"
    tOptionAdminAreaDistrictEngineeringOffice ||--o{ vAdminImplementingOffice    : "ParticipantId (DEO)"
    tOptionAdminAreaRegion                   ||--o{ vAdminImplementingOffice    : "ParticipantId (Region)"
    tOptionAdminAreaCentralOffices           ||--o{ vAdminImplementingOffice    : "ParticipantId (CO)"
    tOptionAdminAreaUPMO                     ||--o{ vAdminImplementingOffice    : "ParticipantId (UPMO)"
    tOptionAdminBureau                       ||--o{ vAdminImplementingOffice    : "ParticipantId (Bureau)"
    vAdminOperatingUnit                      ||--o{ tProjectRevisions           : "ParticipantId > OperatingUnit"
    vAdminImplementingOffice                 ||--o{ tProjectRevisions           : "ParticipantId > ImplementingOffice"