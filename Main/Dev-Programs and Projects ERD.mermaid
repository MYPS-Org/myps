erDiagram

    %% ─── PROGRAM GROUP ───────────────────────────────────────

    tPrograms {
        int         Id                  PK
        nvarchar    ProgramId           UK
        nvarchar    CreatedBy
        datetime    CreatedDate
        bit         IsDeleted
        bit         IsSkipped
        nvarchar    SkipReason
        bit         IsPublished
        int         RevisionNumber
    }

    tProgramStages {
        int         Id                  PK
        nvarchar    ProgramId           FK
        nvarchar    ProgramUniqueId
        int         RevisionId          FK
        int         StageId             FK
        nvarchar    StageName           FK
        nvarchar    CreatedBy
        datetime    CreatedDate
        bit         IsPublished
    }

    tProgramRevisions {
        int         Id                  PK
        nvarchar    ProgramId           FK
        int         RevisionNumber
        nvarchar    Name
        nvarchar    UserGroup
        nvarchar    DataSecurityGroup
        int         Status
        int         Type
        float       Cost
        int         YearStart
        nvarchar    CreatedBy
        datetime    CreatedDate
        nvarchar    ProgramUniqueId
    }

    %% ─── PROJECT GROUP ───────────────────────────────────────

    tProjects {
        int         Id                  PK
        nvarchar    ProgramId           FK
        nvarchar    ReferenceId         UK
        nvarchar    CreatedBy
        datetime    CreatedDate
        bit         IsDeleted
        bit         IsPublished
        nvarchar    ProgramUniqueId
        nvarchar    AlternateId
        nvarchar    OriginProjectId
    }

    tProjectStages {
        int         Id                  PK
        nvarchar    ReferenceId         FK
        nvarchar    ProgramId           FK
        nvarchar    ProgramUniqueId
        int         RevisionId          FK
        int         StageId             FK
        nvarchar    StageName           FK
        nvarchar    CreatedBy
        datetime    CreatedDate
    }

    tProjectRevisions {
        int         Id                  PK
        nvarchar    ProgramId           FK
        nvarchar    ReferenceId
        nvarchar    ProjectId           FK
        nvarchar    AlternateId
        nvarchar    ExternalId
        nvarchar    MYId
        nvarchar    UACS
        datetime    MYCAApprovalDate
        int         RevisionNumber
        nvarchar    Description
        int         Category            FK
        int         Thrust              FK
        int         Origin              FK
        nvarchar    City                FK
        nvarchar    Province            FK
        nvarchar    LegislativeDistrict FK
        nvarchar    OperatingUnit       FK
        nvarchar    ImplementingOffice  FK
        nvarchar    DEO                 FK
        nvarchar    Region              FK
        int         Agency              FK
        int         ImplementationMode  FK
        int         EmergencyMode       FK
        nvarchar    IslandCode          FK
        int         Feasibility         FK
        datetime    FeasibilityDate
        int         DetailedDesign      FK
        datetime    DetailedDesignDate
        int         RowAvailable        FK
        int         RegionWide          FK
        int         Tier
        float       Rank
        bit         IsRevised
        int         RevisedNumber
        nvarchar    CreatedBy
        datetime    CreatedDate
        bit         IsPublishable
        bit         IsDeleted
        nvarchar    ProgramUniqueId
    }

    %% ─── COMPONENT GROUP ─────────────────────────────────────

    tOptionProjectComponentType {
        int         Id                  PK
        nvarchar    ComponentId         UK
        nvarchar    ComponentName
        bit         ExportToPCMA
        bit         IsDeleted
    }

    tProjectComponentCost {
        int         Id                  PK
        nvarchar    ProjectId           FK
        nvarchar    CostId              UK
        nvarchar    ComponentType
        nvarchar    ComponentId         FK
        nvarchar    Description
        float       Total
        nvarchar    StageName           FK
        nvarchar    CreatedBy
        datetime    CreatedDate
        nvarchar    UpdatedBy
        datetime    UpdatedDate
        bit         IsDeleted
        nvarchar    ProgramUniqueId
        nvarchar    ConstructionStatusCode
        nvarchar    ConstructionStatusName
        bit         PackedStatusCode
        nvarchar    PackedStatusName
    }

    tProjectComponentCostPerYear {
        int         Id                  PK
        nvarchar    ComponentCostId     FK
        float       Amount
        int         Year
        datetime    StartDate
        datetime    EndDate
        nvarchar    StageName           FK
        nvarchar    CreatedBy
        datetime    CreatedDate
        nvarchar    UpdatedBy
        datetime    UpdatedDate
        bit         IsDeleted
        nvarchar    ProgramUniqueId
    }

    %% ─── MAJOR WORK GROUP ────────────────────────────────────

    tOptionScopeOfWork {
