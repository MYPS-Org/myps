<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121. -->
<Project>
  <PropertyGroup>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <LaunchSiteAfterPublish>true</LaunchSiteAfterPublish>
    <LastUsedBuildConfiguration>Staging</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish>http://dpwh.eptisa-dev.com</SiteUrlToLaunchAfterPublish>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <ProjectGuid>b48d953b-c4c5-40b5-ade2-1f27a3fea0ea</ProjectGuid>
    <SelfContained>false</SelfContained>
    <MSDeployServiceURL>http://dpwh.eptisa-dev.com</MSDeployServiceURL>
    <DeployIisAppPath>dpwh.eptisa-dev.com</DeployIisAppPath>
    <RemoteSitePhysicalPath />
    <SkipExtraFilesOnServer>true</SkipExtraFilesOnServer>
    <MSDeployPublishMethod>RemoteAgent</MSDeployPublishMethod>
    <EnableMSDeployBackup>true</EnableMSDeployBackup>
    <EnableMsDeployAppOffline>true</EnableMsDeployAppOffline>
    <UserName>Administrator</UserName>
    <_SavePWD>true</_SavePWD>
    <_TargetId>IISWebDeploy</_TargetId>
    <TargetFramework>net8.0</TargetFramework>
	<EnvironmentName>Staging</EnvironmentName>
    <PublishDatabaseSettings>False</PublishDatabaseSettings>
  </PropertyGroup>
  <ItemGroup>
    <MsDeploySkipRules Include="SkipUploadedFiles">
      <ObjectName>dirPath</ObjectName>
      <AbsolutePath>Resources\\UploadedFiles</AbsolutePath>
    </MsDeploySkipRules>
  </ItemGroup>
</Project>