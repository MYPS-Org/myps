# Local-only overrides. Vite loads this AFTER .env.development, so these win.
# Gitignored and untracked (see .gitignore) — safe to edit freely.
#
# NOTE: Vite reads these at dev-server START. Restart `npm run dev` after
# changing anything here; a browser refresh alone will not pick it up.
#
# The landing route is now chosen at runtime by src/utils/offlineMode.ts:
#   VPN up   (backend answers /auth/validate) -> VITE_DEFAULT_ROUTE
#   VPN down (backend unreachable)            -> VITE_OFFLINE_ROUTE, with a
#                                                fabricated local session
# Set VITE_OFFLINE_FALLBACK=false to disable the fallback and always go to /login.
VITE_API_BASE_URL=http://localhost:5015
VITE_DEFAULT_ROUTE=/dashboard
# WAS /multiyear -> a blank page. The whole MultiYear module is declared in
# appRouteList.ts and tAppViews but has NO element registered in Routes.tsx,
# so neither /multiyear nor /multiyear/programs resolves. React Router logged
# "No routes matched location /multiyear" and rendered nothing.
# /dashboard is registered, so the shell renders even with the backend down.
VITE_OFFLINE_ROUTE=/dashboard
VITE_OFFLINE_FALLBACK=true
